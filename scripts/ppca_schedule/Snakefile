# PPCA schedule experiments: does a mean-only start, with PCs joining later, separate the states better?
#
# Per arm and seed (config.yaml: `arms`, `seeds`), six stages:
#   1. train_ppca     relax ppca_initial_model on the eleven-state fixture with the arm's schedule flags.   [GPU]
#   2. score_latents  how well the final latents separate the true states (scripts/analyze_ppca_latents.py).
#   3. plot_run       the standard run figures: latents by true state, volume projections, and the shell gates
#                     of a VDAM run (scripts/plot_ppca_run.py).
#   4. plot_umap      UMAP of the final latents coloured by true state (scripts/plot_ppca_umap.py); arms with q >= 2.
#   5. plot_pose_accuracy  the expected rotation accuracy (acc_rot, acc_rot_mean_only) along the run
#                     (scripts/plot_ppca_pose_accuracy.py); only arms with --order-rule accuracy, the others make no estimate.
#   6. plot_mean_vs_truth  the run's mean against the ground-truth mean by shell and band of shells, with the loadings'
#                     power (scripts/plot_ppca_mean_vs_truth.py); only arms with `init_truth_mean`, whose frame it shares.
#   7. summary_table  one row per arm and seed: the scores of every run.
# An arm with `init_truth_mean: true` starts its mean from the fixture's ground truth instead of the random seed's
# (truth_mean_map, scripts/write_ppca_truth_mean.py, which sets the map's sign from the data; relax ppca_initial_model
# --init-mean-map).
#
# Outputs, under config `output_root`:
#   <arm>/seed<seed>/     checkpoint_NNNN.npz, iterations.jsonl, run.json, embeddings.npz, latent_scores.json
#   <arm>/seed<seed>/plots/   pc_histogram.png (q = 1) or pc_scatter.png and pc_density.png (q > 1),
#                         volume_projections.png, latents_pc_ordered.npz, gates_spectrogram.png (VDAM arms only),
#                         umap.png and umap_embedding.npy (q >= 2), pose_accuracy.png and .json (--order-rule accuracy),
#                         mean_vs_truth.png and .json (init_truth_mean)
#   truth_mean.mrc        the ground-truth mean map (only when an arm starts from it)
#   summary.tsv           the scores of every arm and seed
#   logs/                 one log per rule, arm and seed
#
# Settings: config.yaml holds the experiment (training settings, seeds, arms). The locations that differ between sites
# (output_root, natives_dir, fixture) are null there; set them in a site file kept outside the repository (copy
# site.example.yaml) and pass it with --configfile, which overrides config.yaml.
#
# Run from a frozen copy of the checkout (the jobs import the code at their start). --directory keeps Snakemake's
# metadata and the Slurm logs beside the results; the target goes first, because --config takes what follows it. The
# Slurm profile is yours (--profile): the rules ask only for gpu=1 where they need one, and for runtime and memory:
#   snakemake --snakefile <snapshot>/scripts/ppca_schedule/Snakefile --directory <dir> --profile <profile> all \
#       --configfile <site.yaml> --config output_root=<dir> [only_arms=[a,b]] [seeds=[11]]

import csv
import json
import os
import re
import shlex
from pathlib import Path

from snakemake.exceptions import WorkflowError


configfile: os.path.join(workflow.basedir, "config.yaml")


# ----------------------------------------------------------------------------------------------------------------
# Settings
# ----------------------------------------------------------------------------------------------------------------


def required_path(settings, key, label=None):
    """A setting that has no default, as a Path; the error names it ``label`` (default ``key``) and says where to set it."""
    if not settings.get(key):
        raise WorkflowError(f"{label or key} is not set: give it in a site file (--configfile; see site.example.yaml) or with --config")
    return Path(settings[key])


REPO = Path(workflow.basedir).resolve().parents[1]
PYTHON = config["python"] or str(REPO / ".pixi/envs/default/bin/python")
OUTPUT_ROOT = required_path(config, "output_root")
NATIVES = required_path(config, "natives_dir")
FIXTURE = required_path(config, "fixture")
TRAIN = config["train"]
ARMS = config["arms"]
RUN_ARMS = config["only_arms"] or list(ARMS)
SEEDS = config["seeds"]
TRUTH_MEAN = OUTPUT_ROOT / "truth_mean.mrc"

# The pinned environment only: no user site packages, none of the Python or conda variables the Snakemake
# environment sets, this checkout on the import path, and the native library built from it for the GPU rule.
CLEAN_ENV = f"env -u PYTHONHOME -u CONDA_PREFIX -u VIRTUAL_ENV PYTHONNOUSERSITE=1 PYTHONPATH={REPO}"
RUN_ENV = f"{CLEAN_ENV} RELAX_CUDA_LIB={NATIVES}/librelax_cuda.so"


def arm_q(arm):
    """The number of PCs an arm trains: its own --q, else the shared one."""
    args = [str(a) for a in ARMS[arm]["args"]]
    return int(args[args.index("--q") + 1]) if "--q" in args else int(TRAIN["q"])


def arm_optimizer(arm):
    """The optimizer an arm trains with: its own --optimizer, else the shared one."""
    args = [str(a) for a in ARMS[arm]["args"]]
    return args[args.index("--optimizer") + 1] if "--optimizer" in args else str(TRAIN["optimizer"])


def arm_order_rule(arm):
    """The rule that sets an arm's HEALPix order: its own --order-rule, else the stages table."""
    args = [str(a) for a in ARMS[arm]["args"]]
    return args[args.index("--order-rule") + 1] if "--order-rule" in args else "stages"


def output_path(*parts):
    """A path pattern under output_root; {arm} and {seed} stay wildcards."""
    return str(OUTPUT_ROOT.joinpath(*parts))


wildcard_constraints:
    arm="|".join(map(re.escape, ARMS)),
    seed=r"\d+",


localrules:
    all,
    score_latents,
    plot_run,
    summary_table,


UMAP_ARMS = [arm for arm in RUN_ARMS if arm_q(arm) >= 2]
ACCURACY_ARMS = [arm for arm in RUN_ARMS if arm_order_rule(arm) == "accuracy"]
TRUTH_MEAN_ARMS = [arm for arm in RUN_ARMS if ARMS[arm].get("init_truth_mean")]


rule all:
    """Train, score and plot every arm and seed, then write the summary table."""
    input:
        summary=output_path("summary.tsv"),
        plots=expand(output_path("{arm}", "seed{seed}", "plots", "volume_projections.png"), arm=RUN_ARMS, seed=SEEDS),
        umaps=expand(output_path("{arm}", "seed{seed}", "plots", "umap.png"), arm=UMAP_ARMS, seed=SEEDS),
        accuracies=expand(
            output_path("{arm}", "seed{seed}", "plots", "pose_accuracy.png"), arm=ACCURACY_ARMS, seed=SEEDS
        ),
        means=expand(
            output_path("{arm}", "seed{seed}", "plots", "mean_vs_truth.png"), arm=TRUTH_MEAN_ARMS, seed=SEEDS
        ),


# ----------------------------------------------------------------------------------------------------------------
# Stage 1: training
# ----------------------------------------------------------------------------------------------------------------


rule truth_mean_map:
    message:
        "Writing the ground-truth mean of the fixture as a map"
    input:
        script=REPO / "scripts" / "write_ppca_truth_mean.py",
        manifest=FIXTURE / "evaluation" / "manifest.json",
        truth=FIXTURE / "evaluation" / "truth.npz",
        particles_star=FIXTURE / "training" / "particles.star",
    output:
        truth_mean=TRUTH_MEAN,
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        fixture=FIXTURE,
    resources:
        cpus_per_task=4,
        mem="8G",
        runtime=20,
    log:
        output_path("logs", "truth_mean_map.log"),
    shell:
        "{params.env} JAX_PLATFORMS=cpu {params.python} {input.script} {params.fixture} "
        "-o {output.truth_mean} "
        "> {log} 2>&1"


rule train_ppca:
    message:
        "Training arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        particles_star=FIXTURE / "training" / "particles.star",
        truth_mean=lambda wildcards: [TRUTH_MEAN] if ARMS[wildcards.arm].get("init_truth_mean") else [],
    output:
        embeddings=output_path("{arm}", "seed{seed}", "embeddings.npz"),
        iterations=output_path("{arm}", "seed{seed}", "iterations.jsonl"),
    params:
        env=RUN_ENV,
        python=PYTHON,
        diameter=config["particle_diameter_ang"],
        train=TRAIN,
        train_args=" ".join(map(shlex.quote, map(str, TRAIN["args"]))),
        arm_args=lambda wildcards: " ".join(map(shlex.quote, map(str, ARMS[wildcards.arm]["args"]))),
        init_mean=lambda wildcards, input: f"--init-mean-map {input.truth_mean[0]}" if input.truth_mean else "",
        run_dir=lambda wildcards, output: str(Path(output.embeddings).parent),
    resources:
        gpu=1,
        runtime=lambda wildcards: ARMS[wildcards.arm].get("runtime_minutes", TRAIN["runtime_minutes"]),
    log:
        output_path("logs", "{arm}.seed{seed}.train.log"),
    shell:
        "{params.env} {params.python} -m relax.command_line ppca_initial_model "
        "--i {input.particles_star} "
        "--particle-diameter {params.diameter} "
        "-o {params.run_dir} "
        "--q {params.train[q]} "
        "--seed {wildcards.seed} "
        "--iterations {params.train[iterations]} "
        "--stages {params.train[stages]:q} "
        "--optimizer {params.train[optimizer]} "
        "{params.train_args} "
        "{params.arm_args} "
        "{params.init_mean} "
        "> {log} 2>&1"


# ----------------------------------------------------------------------------------------------------------------
# Stage 2: scoring
# ----------------------------------------------------------------------------------------------------------------


rule score_latents:
    message:
        "Scoring the latents of arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        embeddings=rules.train_ppca.output.embeddings,
        truth=FIXTURE / "evaluation" / "truth.npz",
        script=REPO / "scripts" / "analyze_ppca_latents.py",
    output:
        scores=output_path("{arm}", "seed{seed}", "latent_scores.json"),
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        run_dir=lambda wildcards, input: str(Path(input.embeddings).parent),
    log:
        output_path("logs", "{arm}.seed{seed}.score.log"),
    shell:
        "{params.env} JAX_PLATFORMS=cpu {params.python} {input.script} {params.run_dir} "
        "--truth {input.truth} "
        "> {log} 2>&1"


# ----------------------------------------------------------------------------------------------------------------
# Stage 3: figures
# ----------------------------------------------------------------------------------------------------------------


rule plot_run:
    message:
        "Plotting the latents, volumes and gates of arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        embeddings=rules.train_ppca.output.embeddings,
        iterations=rules.train_ppca.output.iterations,
        truth=FIXTURE / "evaluation" / "truth.npz",
        script=REPO / "scripts" / "plot_ppca_run.py",
    output:
        volumes=output_path("{arm}", "seed{seed}", "plots", "volume_projections.png"),
        latents=output_path("{arm}", "seed{seed}", "plots", "latents_pc_ordered.npz"),
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        n_pcs=lambda wildcards: arm_q(wildcards.arm),
        gates=lambda wildcards: "--gates " if arm_optimizer(wildcards.arm) == "vdam" else "",
        run_dir=lambda wildcards, input: str(Path(input.embeddings).parent),
        plots_dir=lambda wildcards, output: str(Path(output.volumes).parent),
    log:
        output_path("logs", "{arm}.seed{seed}.plot.log"),
    shell:
        "{params.env} JAX_PLATFORMS=cpu {params.python} {input.script} {params.run_dir} "
        "--labels {input.truth} "
        "--n-pcs {params.n_pcs} "
        "--skip-umap "
        "{params.gates}"
        "-o {params.plots_dir} "
        "> {log} 2>&1"


rule plot_umap:
    message:
        "UMAP of the latents of arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        latents=rules.plot_run.output.latents,
        truth=FIXTURE / "evaluation" / "truth.npz",
        script=REPO / "scripts" / "plot_ppca_umap.py",
    output:
        umap=output_path("{arm}", "seed{seed}", "plots", "umap.png"),
        embedding=output_path("{arm}", "seed{seed}", "plots", "umap_embedding.npy"),
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        plots_dir=lambda wildcards, output: str(Path(output.umap).parent),
    resources:
        cpus_per_task=4,
        mem="8G",
        runtime=30,
    log:
        output_path("logs", "{arm}.seed{seed}.umap.log"),
    shell:
        "{params.env} {params.python} {input.script} {params.plots_dir} "
        "--labels {input.truth} "
        "> {log} 2>&1"


rule plot_pose_accuracy:
    message:
        "Expected rotation accuracy of arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        iterations=rules.train_ppca.output.iterations,
        script=REPO / "scripts" / "plot_ppca_pose_accuracy.py",
    output:
        figure=output_path("{arm}", "seed{seed}", "plots", "pose_accuracy.png"),
        table=output_path("{arm}", "seed{seed}", "plots", "pose_accuracy.json"),
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        run_dir=lambda wildcards, input: str(Path(input.iterations).parent),
        plots_dir=lambda wildcards, output: str(Path(output.figure).parent),
    resources:
        cpus_per_task=1,
        mem="4G",
        runtime=30,
    log:
        output_path("logs", "{arm}.seed{seed}.pose_accuracy.log"),
    shell:
        "{params.env} JAX_PLATFORMS=cpu {params.python} {input.script} {params.run_dir} "
        "-o {params.plots_dir} "
        "> {log} 2>&1"


rule plot_mean_vs_truth:
    message:
        "Mean against the ground-truth mean, arm {wildcards.arm}, seed {wildcards.seed}"
    input:
        iterations=rules.train_ppca.output.iterations,
        truth_mean=TRUTH_MEAN,
        script=REPO / "scripts" / "plot_ppca_mean_vs_truth.py",
    output:
        figure=output_path("{arm}", "seed{seed}", "plots", "mean_vs_truth.png"),
        table=output_path("{arm}", "seed{seed}", "plots", "mean_vs_truth.json"),
    params:
        env=CLEAN_ENV,
        python=PYTHON,
        run_dir=lambda wildcards, input: str(Path(input.iterations).parent),
        plots_dir=lambda wildcards, output: str(Path(output.figure).parent),
    resources:
        cpus_per_task=1,
        mem="8G",
        runtime=30,
    log:
        output_path("logs", "{arm}.seed{seed}.mean_vs_truth.log"),
    shell:
        "{params.env} JAX_PLATFORMS=cpu {params.python} {input.script} {params.run_dir} "
        "--truth-map {input.truth_mean} "
        "-o {params.plots_dir} "
        "> {log} 2>&1"


# ----------------------------------------------------------------------------------------------------------------
# Stage 7: summary
# ----------------------------------------------------------------------------------------------------------------


rule summary_table:
    message:
        "Collecting the scores of every arm and seed"
    input:
        scores=expand(rules.score_latents.output.scores, arm=RUN_ARMS, seed=SEEDS),
    output:
        summary=output_path("summary.tsv"),
    run:
        rows = []
        for path in input.scores:
            arm, seed = Path(path).parent.parent.name, Path(path).parent.name.removeprefix("seed")
            rows.append({"arm": arm, "seed": seed, **json.loads(Path(path).read_text())})
        with open(output.summary, "w", newline="") as stream:
            writer = csv.DictWriter(stream, fieldnames=list(rows[0]), delimiter="\t")
            writer.writeheader()
            writer.writerows(rows)
